# Copy only the variables you need into an external, untracked secret file.
# Secret values are intentionally empty in this template.
AISURGEON_SECRET_ENV_FILE=
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
GEMINI_API_KEY=

# Local PostgreSQL/pgvector configuration.
AISURGEON_DB_NAME=aisurgeon_retrieval
AISURGEON_DB_USER=aisurgeon
AISURGEON_DB_PASSWORD=
AISURGEON_DB_PORT=55432

# Public, reproducible retrieval defaults.
AISURGEON_CORPUS_SNAPSHOT_ID=cs-f61b3d4e90089c1b890c23cb
AISURGEON_EMBEDDING_MODEL=text-embedding-3-small
AISURGEON_EMBEDDING_DIMENSION=1536
OPENAI_RESPONSE_MODEL=gpt-5.4-nano-2026-03-17
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=6000
STUDY_MAX_ESTIMATED_API_COST_USD=500.00
